    {
      "parameters": {
        "jsCode": "const hoy = $now.setZone('Europe/Madrid');\n\nfunction nombreDia(dt) {\n  const nombres = ['lunes','martes','miércoles','jueves','viernes','sábado','domingo'];\n  return nombres[dt.weekday - 1];\n}\n\nfunction formatear(dt) {\n  return `${nombreDia(dt)} ${dt.day} de ${dt.setLocale('es').monthLong} de ${dt.year} (${dt.toFormat('yyyy-MM-dd')})`;\n}\n\nconst manana = hoy.plus({ days: 1 });\nconst pasadoManana = hoy.plus({ days: 2 });\n\nconst nombresObjetivo = ['lunes','martes','miércoles','jueves','viernes','sábado','domingo'];\nlet proximosDias = {};\nfor (let i = 1; i <= 7; i++) {\n  const fecha = hoy.plus({ days: i });\n  const nombre = nombreDia(fecha);\n  if (!proximosDias[nombre]) {\n    proximosDias[nombre] = fecha;\n  }\n}\n\nlet tabla = `Hoy es ${formatear(hoy)}.\\n`;\ntabla += `Mañana es ${formatear(manana)}.\\n`;\ntabla += `Pasado mañana es ${formatear(pasadoManana)}.\\n`;\ntabla += 'Próximas fechas para cada día de la semana:\\n';\nfor (const nombre of nombresObjetivo) {\n  tabla += `- Próximo ${nombre}: ${formatear(proximosDias[nombre])}\\n`;\n}\n\nreturn [{ json: { ...$json, tabla_fechas: tabla } }];"
      },
